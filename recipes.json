    {
      "id": "french-toast",
      "name": "法式吐司",
      "time": 10,
      "level": "簡單",
      "type": "甜",
      "servings": 1,
      "ingredients": [
        {
          "name": "吐司",
          "qty": 2,
          "unit": "片"
        },
        {
          "name": "雞蛋",
          "qty": 1,
          "unit": "顆"
        },
        {
          "name": "牛奶",
          "qty": 50,
          "unit": "ml"
        },
        {
          "name": "奶油",
          "qty": 5,
          "unit": "g"
        },
        {
          "name": "蜂蜜或楓糖",
          "qty": 1,
          "unit": "大匙"
        }
      ],
      "steps": [
        "雞蛋打散，加入牛奶攪拌均勻。",
        "吐司兩面各浸入蛋液約 10 秒。",
        "平底鍋中小火融化奶油，放入吐司。",
        "每面煎約 2 分鐘至金黃。",
        "盛盤，淋上蜂蜜或楓糖。"
      ],
      "tip": "吐司放隔夜、稍微乾一點，比較吸蛋液、不容易破。"
    },
    {
      "id": "ham-cheese-egg",
      "name": "火腿起司蛋吐司",
      "time": 8,
      "level": "簡單",
      "type": "鹹",
      "servings": 1,
      "ingredients": [
        {
          "name": "吐司",
          "qty": 2,
          "unit": "片"
        },
        {
          "name": "雞蛋",
          "qty": 1,
          "unit": "顆"
        },
        {
          "name": "火腿",
          "qty": 1,
          "unit": "片"
        },
        {
          "name": "起司片",
          "qty": 1,
          "unit": "片"
        },
        {
          "name": "沙拉油",
          "qty": 1,
          "unit": "小匙"
        }
      ],
      "steps": [
        "吐司放進烤麵包機烤至微脆。",
        "平底鍋加油，煎一顆荷包蛋。",
        "火腿片放入鍋中兩面各煎 30 秒。",
        "吐司依序疊上起司、火腿、荷包蛋，再蓋上另一片吐司。",
        "斜切對半即可。"
      ],
      "tip": "起司放在熱吐司上會微微融化，口感更好。"
    },
    {
      "id": "oat-yogurt",
      "name": "燕麥優格杯",
      "time": 5,
      "level": "簡單",
      "type": "甜",
      "servings": 1,
      "ingredients": [
        {
          "name": "無糖優格",
          "qty": 150,
          "unit": "g"
        },
        {
          "name": "即食燕麥",
          "qty": 30,
          "unit": "g"
        },
        {
          "name": "香蕉",
          "qty": 0.5,
          "unit": "根"
        },
        {
          "name": "藍莓或當季水果",
          "qty": 50,
          "unit": "g"
        },
        {
          "name": "蜂蜜",
          "qty": 1,
          "unit": "小匙"
        }
      ],
      "steps": [
        "香蕉切片、水果洗淨備用。",
        "杯中先放一半優格，鋪上一半燕麥。",
        "重複一次優格和燕麥。",
        "最上層放水果，淋上蜂蜜。"
      ],
      "tip": "前一晚做好放冰箱，燕麥會吸收水分變軟，早上直接吃。"
    },
    {
      "id": "egg-pancake",
      "name": "蔥花蛋餅",
      "time": 10,
      "level": "簡單",
      "type": "鹹",
      "servings": 1,
      "ingredients": [
        {
          "name": "市售冷凍蛋餅皮",
          "qty": 1,
          "unit": "張"
        },
        {
          "name": "雞蛋",
          "qty": 1,
          "unit": "顆"
        },
        {
          "name": "青蔥",
          "qty": 1,
          "unit": "根"
        },
        {
          "name": "鹽",
          "qty": 0.25,
          "unit": "小匙"
        },
        {
          "name": "沙拉油",
          "qty": 1,
          "unit": "小匙"
        }
      ],
      "steps": [
        "青蔥切成蔥花，和雞蛋、鹽一起打散。",
        "平底鍋加油，中火倒入蛋液。",
        "蛋液半熟時，蓋上蛋餅皮（不用退冰）。",
        "約 1 分鐘後翻面，再煎 1–2 分鐘至餅皮微焦。",
        "捲起切段，可沾醬油膏。"
      ],
      "tip": "加一片起司或玉米粒，就是起司蛋餅、玉米蛋餅。"
    },
    {
      "id": "banana-pancake",
      "name": "香蕉鬆餅",
      "time": 15,
      "level": "中等",
      "type": "甜",
      "servings": 2,
      "ingredients": [
        {
          "name": "熟香蕉",
          "qty": 1,
          "unit": "根"
        },
        {
          "name": "雞蛋",
          "qty": 1,
          "unit": "顆"
        },
        {
          "name": "鬆餅粉",
          "qty": 100,
          "unit": "g"
        },
        {
          "name": "牛奶",
          "qty": 80,
          "unit": "ml"
        },
        {
          "name": "奶油",
          "qty": 5,
          "unit": "g"
        }
      ],
      "steps": [
        "香蕉用叉子壓成泥。",
        "加入雞蛋、牛奶拌勻，再加入鬆餅粉拌到沒有粉粒。",
        "平底鍋小火抹薄薄一層奶油。",
        "每次倒入約一大湯匙麵糊，表面冒泡泡時翻面。",
        "兩面金黃即可起鍋。"
      ],
      "tip": "香蕉越熟越甜，表皮有黑點的最適合。"
    },
    {
