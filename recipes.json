      "name": "酪梨蛋吐司",
      "time": 10,
      "level": "簡單",
      "type": "鹹",
      "servings": 1,
      "ingredients": [
        {
          "name": "全麥吐司",
          "qty": 1,
          "unit": "片"
        },
        {
          "name": "熟酪梨",
          "qty": 0.5,
          "unit": "顆"
        },
        {
          "name": "雞蛋",
          "qty": 1,
          "unit": "顆"
        },
        {
          "name": "檸檬汁",
          "qty": 1,
          "unit": "小匙"
        },
        {
          "name": "鹽與黑胡椒",
          "qty": null,
          "unit": "少許"
        }
      ],
      "steps": [
        "雞蛋放入滾水煮 7 分鐘，泡冷水後剝殼切片。",
        "酪梨壓成泥，加檸檬汁、鹽拌勻。",
        "吐司烤至微脆，抹上酪梨泥。",
        "鋪上蛋片，撒黑胡椒。"
      ],
      "tip": "檸檬汁可以防止酪梨變黑。"
    },
